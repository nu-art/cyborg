<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	>

	<FrameLayout
		android:id="@+id/unity_container"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		/>

	<LinearLayout
		android:id="@+id/unity_overlay"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="#CC000000"
		android:clickable="true"
		android:orientation="vertical"
		android:padding="12dp"
		>

		<Button
			android:id="@+id/BTN_PingUnity"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Recolor cube"
			/>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingTop="8dp"
			>

			<View
				android:id="@+id/color_chip"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:background="#333333"
				/>

			<TextView
				android:id="@+id/TV_FromUnity"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:text="tap the cube to report its color"
				android:textColor="#FFFFFF"
				/>
		</LinearLayout>

	</LinearLayout>

</FrameLayout>
